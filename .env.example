# =============================================================================
# MotionHub — environment variable names (NO real secrets in this file)
# =============================================================================
# Copy sections into each service’s real `.env` / Vercel / Railway dashboard.
# Production: set the same logical values (e.g. Discord channel IDs) everywhere
# they must match (bot + site).
#
# DATABASE_URL: use Neon / Supabase / Railway Postgres — never commit the URL.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL + Prisma (league-api, league-worker, `prisma migrate` from packages/db)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# -----------------------------------------------------------------------------
# Redis (league-api BullMQ + league-worker)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380

# -----------------------------------------------------------------------------
# league-api (Railway / Fly / Render — set PORT if host requires it)
# -----------------------------------------------------------------------------
PORT=4001

# -----------------------------------------------------------------------------
# league-worker (replay ingest — same DB + Redis as API; shared storage path)
# -----------------------------------------------------------------------------
REPLAY_UPLOADS_DIR=/path/to/replays
# REPLAY_PARSER_PATH=optional/path/to/parser

# -----------------------------------------------------------------------------
# league-site — Vercel (also copy relevant vars to `.env.local` for local dev)
# Root directory in Vercel: league-platform/apps/league-site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-site.vercel.app
LEAGUE_API_BASE_URL=https://your-league-api.up.railway.app

REPLAY_UPLOADS_DIR=
# Google Sheets (optional — players sync)
# PLAYERS_SHEET_ID=
# PLAYERS_SHEET_RANGE=Form Responses 1!A:Z
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
# PLAYERS_SHEET_CSV_URL=

AUTH_SESSION_SECRET=replace-with-long-random-secret

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-site.vercel.app/api/auth/callback

DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=

DISCORD_MATCH_ANNOUNCE_CHANNEL_ID=
DISCORD_MATCH_RESULTS_CHANNEL_ID=
# DISCORD_MATCH_POD_CATEGORY_ID=
# NEXT_PUBLIC_DISCORD_MATCH_POD_MODE=0
# DISCORD_MATCH_VOICE_1_LABEL=
# DISCORD_MATCH_VOICE_2_LABEL=
# DISCORD_BOT_STAFF_ROLE_ID=

MOTION_BOT_REGISTER_URL=https://your-bot.up.railway.app
MOTION_BOT_INTERNAL_SECRET=same-as-BOT_INTERNAL_SECRET-on-railway

DISCORD_ROLE_FOUNDER_ID=
DISCORD_ROLE_STAFF_ID=
DISCORD_ROLE_PARTNER_ID=
# DISCORD_TEAM_ROLE_OPTIONS=

# -----------------------------------------------------------------------------
# MotionBot — Railway (root directory: MotionBot)
# -----------------------------------------------------------------------------
TOKEN=
CLIENT_ID=
GUILD_ID=

CHANNEL_MATCH_ANNOUNCE=
CHANNEL_MATCH_RESULTS=
CHANNEL_PROCESSING_QUEUE=
CHANNEL_STAFF_CHAT=

ROLE_STAFF=

# BOT_INTERNAL_SECRET=   # must match league-site MOTION_BOT_INTERNAL_SECRET
# Railway sets PORT; bot may use BOT_HTTP_PORT
# BOT_HTTP_PORT=3849

# Optional labels:
# EMBED_FOOTER_TEXT=
# BOT_ACTIVITY_TEXT=
# MATCH_ROOM_1_LABEL=Match Voice A
# MATCH_ROOM_2_LABEL=Match Voice B

# Optional: schedule poller → Hub sync API
# TOURNAMENT_SYNC_URL=https://your-notes-api.vercel.app
# POLL_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# hub-app/notes-api — Vercel (root directory: hub-app/notes-api)
# -----------------------------------------------------------------------------
# GITHUB_TOKEN=            # if API reads/writes a repo; see hub-app/notes-api README
# SYNC_DOMAIN=sync.example.com
