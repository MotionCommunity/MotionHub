# Discord
TOKEN=your_bot_token
CLIENT_ID=your_application_id
GUILD_ID=your_server_id

# Channels
CHANNEL_MATCH_ANNOUNCE=channel_id_for_match_announcements
CHANNEL_MATCH_RESULTS=channel_id_for_match_threads
CHANNEL_PROCESSING_QUEUE=channel_id_for_processing_queue
CHANNEL_STAFF_CHAT=channel_id_for_staff_chat

# Roles
ROLE_STAFF=staff_role_id
ROLE_REGISTERED=registered_role_id
ROLE_CHECKED_IN=checked_in_role_id

# Schedule from Motion Hub (optional — same as Hub's Notes sync URL)
# When set, the bot polls scheduledMatches and posts match calls to CHANNEL_MATCH_ANNOUNCE.
TOURNAMENT_SYNC_URL=https://motion-notes-api.vercel.app
# POLL_INTERVAL_MS=60000
