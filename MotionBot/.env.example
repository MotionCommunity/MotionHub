# ── Discord app (Discord Developer Portal → Application) ───────────────────
TOKEN=your_bot_token
CLIENT_ID=your_application_id
GUILD_ID=your_server_id

# ── Channels (right-click channel in Discord → Copy ID) ─────────────────────
# Ready-up posts from /match create; schedule poller posts here too.
CHANNEL_MATCH_ANNOUNCE=channel_id
# Same as above — optional alias:
# DISCORD_MATCH_CHANNEL_ID=

# Parent channel where match threads are created (e.g. #match-results)
CHANNEL_MATCH_RESULTS=channel_id

# Staff sees confirmed replays here
CHANNEL_PROCESSING_QUEUE=channel_id

# Staff log / pings
CHANNEL_STAFF_CHAT=channel_id

# ── Roles (Server Settings → Roles → … → Copy ID) ──────────────────────────
ROLE_STAFF=staff_role_id

# ── Optional: labels (not IDs) ──────────────────────────────────────────────
# EMBED_FOOTER_TEXT=Your League Name
# BOT_ACTIVITY_TEXT=Playing Your League
# Two shared voice slots (matches /match create choices)
# MATCH_ROOM_1_LABEL=Match Voice A
# MATCH_ROOM_2_LABEL=Match Voice B

# ── Schedule poller (optional) ─────────────────────────────────────────────
# TOURNAMENT_SYNC_URL=https://motion-notes-api.vercel.app
# POLL_INTERVAL_MS=60000

# ── League site → replay timer (optional) ───────────────────────────────────
# Same random string on bot and site (MOTION_BOT_INTERNAL_SECRET).
# BOT_INTERNAL_SECRET=
# HTTP port for POST /internal/register-match-thread (default 3849; Railway may set PORT)
# BOT_HTTP_PORT=3849
