{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/notes", "dest": "/api/notes.js" },
    { "src": "/api/note", "dest": "/api/note.js" },
    { "src": "/api/suggested-rules", "dest": "/api/suggested-rules.js" },
    { "src": "/api/suggested-stats", "dest": "/api/suggested-stats.js" },
    { "src": "/api/suggested-bracket", "dest": "/api/suggested-bracket.js" },
    { "src": "/api/tournament-sync", "dest": "/api/tournament-sync.js" }
  ]
}
